# Console(platform.claude.com)에서 발급한 API 키. CVP 승인 조직의 키를 사용하세요.
# Claude 구독(claude.ai) 로그인 토큰(sk-ant-oat...)은 사용할 수 없습니다.
ANTHROPIC_API_KEY=

# 사용할 모델 ID (하드코딩된 기본값 없음). `cvp models`로 조회 후 설정하세요.
CVP_MODEL=

# 세션당 예상 비용 한도(USD). CLI 자체 차단이며 실제 청구를 완벽히 막지는 못합니다.
CVP_MAX_SESSION_COST_USD=1.00

# (선택) CVP 승인 조직 ID. 설정 시 API 응답 헤더의 조직 ID와 대조합니다.
CVP_EXPECTED_ORG_ID=
